  "excluded": {
    "configured/full-page viewers": "full scene parity with adopted moon remains unapproved",
    "multi-photo equal grid": "user requires varied sizes and asymmetric positions",
    "historical PoC dispatchers": "experiments are not alternate production runtimes",
    "camera-only mug inspection": "selected project motion uses body-spin/tilt/axis-precession"
  },
  "pending": [
    "new-project finished-page assembly with approved scene parity",
    "multi-photo placement rule",
    "new-project end-to-end evaluation"
  ],
  "profileSource": {
    "path": "scripts/jomul-design-profile.json",
    "sha256": "7d2c6db7f856456c99940767577e2ea7551d79ebc3cf23a9d9faf73c00d37c04"
  },
  "decisions": [
    {
      "id": "input-evidence",
      "state": "implemented",
      "rule": "Keep source hashes, source regions, ranges, real verbatim replies and unresolved fields; do not promote assumptions to manufacturing confirmations.",
      "consumer": [
        "scripts/jomul_intake.py",
        "scripts/workflow.py",
        "scripts/spec_handoff.py"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "P1 answer ranges, source provenance and rejecting repeated confirmations"
      }
    },
    {
      "id": "shrinkage",
      "state": "implemented-explicit-input",
      "rule": "Use explicit source-backed shrinkage; preserve dimension intervals and confirmation provenance; no generic clay-based rate inference.",
      "consumer": [
        "scripts/clay-shrinkage.mjs"
      ],
      "verification": {
        "suites": [
          "shrinkage"
        ],
        "scope": "Explicit shrinkage conversion and intervals"
      }
    },
    {
      "id": "composition",
      "state": "implemented",
      "rule": "One vessel including its handle is one part; single/multiple share one CAD generator; support one or two rotational parts and one handled solid.",
      "consumer": [
        "scripts/project.py",
        "scripts/shared_sheet_poc.py"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "One/two-part CAD fixtures and handled vessel fixture"
      }
    },
    {
      "id": "cad-style",
      "state": "implemented",
      "profile": "cad",
      "rule": "White borderless technical dense sheet with selected views, English labels except clay/glaze, profile-based isometric rings, one sheet for all parts.",
      "consumer": [
        "scripts/shared_sheet_poc.py",
        "scripts/isometric_geometry.py",
        "scripts/check_shared_sheet_poc.py"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "Six regenerated single/multiple SVGs equal selected baselines; CAD contract verification"
      }
    },
    {
      "id": "handled-geometry",
      "state": "implemented",
      "rule": "One hollow fused solid, smooth shape-preserving handle path, both joint volumes and cavity clearance, STEP roundtrip, CAD-sourced wire; explicit provisional status.",
      "consumer": [
        "scripts/handled_geometry.py",
        "scripts/jomul_handled_solid.py",
        "scripts/prepare_handled.py"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "Synthetic hollow handled solid, STEP roundtrip and geometry checks"
      }
    },
    {
      "id": "axis-motion",
      "state": "implemented-for-single-handled",
      "profile": "motion.axisRig",
      "rule": "Body spin under tilt under axis precession; minimum complete body and axis turns; no camera-only orbit substitution.",
      "consumer": [
        "scripts/motion.py",
        "assets/motion/axis-motion.mjs",
        "assets/motion/viewer.js"
      ],
      "verification": {
        "suites": [
          "axis"
        ],
        "scope": "Pose and group rotation behavior across six progress points; not rendered clipping",
        "browserCheck": "scripts/check-motion.cjs (four viewports / 24 scenes via motion-preview)"
      }
    },
    {
      "id": "single-framing",
      "state": "selected-requirement-full-page-pending",
      "profile": "motion.singleFraming",
      "rule": "Model-relative framing and viewport occupancy; study-only-no-zoom is not the selected presentation.",
      "verification": {
        "suites": [],
        "scope": "Full-page vessel occupancy",
        "pendingReason": "Not covered by this runner; full-page/new-project implementation or browser evidence required."
      }
    },
    {
      "id": "page-composition",
      "state": "implemented-for-handled-preview-full-page-pending",
      "profile": "page",
      "rule": "Contain full CAD at viewport maximum; no visible narration/header/badge/footer; preserve CAD annotations.",
      "verification": {
        "suites": [],
        "scope": "Rendered CAD sizing and visible page text",
        "pendingReason": "Not covered by this runner; full-page/new-project implementation or browser evidence required.",
        "browserCheck": "scripts/check-motion.cjs (four viewports / 24 scenes via motion-preview)"
      }
    },
    {
      "id": "scene-background",
      "state": "component-verified-full-page-pending",
      "profile": "motion.backgroundBaseline",
      "rule": "White CAD, dark studio, light photo handoff.",
      "consumer": [
        "assets/scene/background-transition.mjs"
      ],
      "verification": {
        "suites": [
          "background"
        ],
        "scope": "Background component sampled timeline; not assembled page"
      }
    },
    {
      "id": "glaze-motion",
      "state": "component-verified-full-page-pending",
      "profile": "motion.glazeDirection",
      "rule": "Foot-to-rim reveal with continuing spin and axis through coating.",
      "consumer": [
        "assets/scene/glaze-motion.mjs"
      ],
      "verification": {
        "suites": [
          "glaze"
        ],
        "scope": "Bottom-up reveal, continuing spin/axis component behavior; not rendered material"
      }
    },
    {
      "id": "photo-provenance",
      "state": "implemented",
      "rule": "Distinct final-fired/process roles, source hashes, EXIF-free export; never duplicate a source as distinct final photos.",
      "consumer": [
        "scripts/photos.py"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "Photo roles, hashes, omission and rejection of unadopted layouts"
      }
    },
    {
      "id": "gallery-selected",
      "state": "implemented-component",
      "profile": "gallery",
      "rule": "Preserve selected hero photo and optional smaller process photo, 100vh, no visible title/caption or following section, selected frame/pointer/enlarge behavior. Zero photos omit the gallery.",
      "consumer": [
        "scripts/gallery_markup.py",
        "scripts/gallery_profile.py",
        "assets/gallery/gallery.css",
        "assets/gallery/gallery.js"
      ],
      "verification": {
        "suites": [
          "runtime"
        ],
        "scope": "Generated hero/process markup and omission; browser frame/pointer parity requires separate check",
        "browserCheck": "tests/check-gallery-parity.cjs (desktop/mobile reference comparison)"
      }
    },
    {
      "id": "gallery-general-multiple",
      "state": "implemented-candidate-visual-adoption-pending",
      "rule": "Explicit scatter candidate for 2–8 photos: distinct bounded sizes/asymmetric placement, stable seed and responsive placements stored in output manifest; photo role does not select placement. Default selected hero/process pair remains unchanged. Visual adoption pending.",
      "verification": {
        "suites": [
          "gallery-layout",
          "runtime"
        ],
        "scope": "2–8 placement bounds/nonoverlap/determinism and role independence; three-photo component generation/repeat/source validation",
        "browserCheck": "tests/check-scatter.cjs (review candidate; separate browser run, not visual adoption)"
      },
      "consumer": [
        "scripts/gallery_layout.py",
        "scripts/gallery_markup.py",
        "scripts/photos.py"
      ]
    },
    {
      "id": "photo-handoff",
      "state": "selected-requirement-full-page-pending",
      "profile": "motion.photoHandoff",
      "rule": "3D exits before gallery entry; no separate photo-only scrolling segment; reverse-scroll behavior must be verified in assembled page.",
      "verification": {
        "suites": [],
        "scope": "Assembled page 3D exit, gallery entry and reverse scroll",
        "pendingReason": "Not covered by this runner; full-page/new-project implementation or browser evidence required."
      }
    },
    {
      "id": "revision",
      "state": "implemented",
      "rule": "Snapshot input/state/output before mutation, verify hashes, restore exact selected snapshot; CAD rebuild invalidates dependent motion.",
      "consumer": [
        "scripts/project.py"
      ],
      "verification": {
        "suites": [
